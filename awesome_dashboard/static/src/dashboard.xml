<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        
        <Layout display="display" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons" >
                <button class="btn btn-primary" t-on-click="openCustomersView">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeadsView">Leads</button>
            </t>
            
            <DashboardItem size="1.5">
                <div class="text-center card-title">
                    Average amount of t-shirt by order this month
                </div>
                <div class="fs-1 fw-bold text-center text-success">
                    <t t-esc="statistics.average_quantity"/>
                </div>
            </DashboardItem>
            <DashboardItem size="1.5">
                <div class="text-center card-title">
                    Average time for an order to go from 'new' to 'cancelled'
                </div>
                <div class="fs-1 fw-bold text-center text-success">
                    <t t-esc="statistics.average_time"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                <div class="text-center card-title">
                    Number of new orders this month
                </div>
                <div class="fs-1 fw-bold text-center text-success">
                    <t t-esc="statistics.nb_new_orders"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                <div class="text-center card-title">
                    Number of cancelled orders this month
                </div>
                <div class="fs-1 fw-bold text-center text-success">
                    <t t-esc="statistics.nb_cancelled_orders"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                <div class="text-center card-title">
                    Total amount of new orders this month
                </div>
                <div class="fs-1 fw-bold text-center text-success">
                    <t t-esc="statistics.total_amount"/>
                </div>
            </DashboardItem>
        </Layout>
    </t>

</templates>
