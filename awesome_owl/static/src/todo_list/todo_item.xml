<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="awesome_owl.todo_item">
        <div>
            <input t-att-id="props.todo.id" type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="onToggled" />
            <label class="ms-2" t-att-for="props.todo.id" t-att-class="{'text-muted text-decoration-line-through': props.todo.isCompleted}">
                <t t-esc="props.todo.id" />. 
                <t t-esc="props.todo.description" />
            </label>
        </div>
    </t>
</templates>